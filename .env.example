# Copiar como .env (que NO se sube al repo) y completar.
# Solo direcciones y claves de API: la clave privada de la plataforma va en el keystore de Foundry (cast wallet import).

# La dirección pública (0x...) de la billetera de la plataforma: va a ser la dueña del contrato
PLATAFORMA_DIRECCION=

# Clave de API de Etherscan (sirve para basescan), para verificar el código del contrato
ETHERSCAN_API_KEY=
